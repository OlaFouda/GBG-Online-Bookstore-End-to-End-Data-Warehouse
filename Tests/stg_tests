  --=========  validating tables relationships ==========

-- categoryID in stg.Categories >> stg.Books

SELECT *
FROM  stg.Books
LEFT JOIN stg.Categories ON stg.Books.CategoryID = stg.Categories.CategoryID
WHERE stg.Categories.CategoryID IS NULL; -- no issue found


-- BookID in stg.Sales.BookID >> stg.Books.BookID
SELECT * 
FROM stg.Sales
LEFT JOIN stg.Books ON stg.Sales.BookID = stg.Books.BookID
WHERE stg.Books.BookID IS NULL; --no issues found

-- PromotionIDs in stg.Sales >> stg.Promotions
SELECT DISTINCT TRIM(SplitPromotions.value) AS PromotionID
FROM stg.Sales
CROSS APPLY STRING_SPLIT(stg.Sales.PromotionIDs, ',') AS SplitPromotions
LEFT JOIN stg.Promotions
    ON TRY_CONVERT(INT, TRIM(SplitPromotions.value)) = stg.Promotions.PromotionID
WHERE stg.Promotions.PromotionID IS NULL; -- ' 99' does no exist im promotion tables ***********

-- multi-value PromotiosID column (checking for empty commas at right, left, middle)
SELECT *
FROM stg.Sales
WHERE PromotionIDs LIKE '%,,%' -- empty comma pair
OR PromotionIDs LIKE '%,' -- comma with no value after
OR PromotionIDs LIKE ',%' ;  --comma with no value before
-- no issues found

-- checking if any PromotionID value is non numeric value
SELECT *
FROM stg.Sales
CROSS APPLY STRING_SPLIT(stg.Sales.PromotionIDs, ',') AS SplitPromotions
WHERE TRY_CONVERT(INT, TRIM(SplitPromotions.value)) IS NULL
AND TRIM(SplitPromotions.value) <> ''; -- no issues found all promotion ids are numeric values



-- checking if SalesLineID is unique
SELECT SalesLineID,
    COUNT(*) AS Repetitions
FROM stg.Sales
GROUP BY SalesLineID
HAVING COUNT(*) > 1; -- no repeated SalesLineID

-- RecieptNumber and LineNumber each has reps, but toghether they are bussinees identifier
WITH RN_LN_CTE AS (SELECT ReceiptNumber,
    LineNumber,
    Count(*) AS Repetitions
FROM stg.Sales
GROUP BY ReceiptNumber, LineNumber
HAVING COUNT(*) > 1 ) -- 4 duplicated values found *****


SELECT stg.Sales.*,
        RN_LN_CTE.Repetitions
FROM stg.Sales INNER JOIN RN_LN_CTE
ON stg.Sales.ReceiptNumber = RN_LN_CTE.ReceiptNumber
AND stg.Sales.LineNumber = RN_LN_CTE.LineNumber; -- using CTE to find all duplicated values 
-- 4 values each duplicated twice

-- verifying that the duplicates are identical (redundant inputs)
-- concatinating all columns values to verify the input is redundant
