-- quality checks

USE Bookstore_DWH

--======== stg.Categories ========

-- checking if nulls exist

SELECT *
FROM stg.Categories
WHERE CategoryName IS NULL
    OR Description IS NULL; -- no nulls found

-- checking for duplicates in bussiness keys

SELECT CategoryID, COUNT(*) AS DuplicateCount
FROM stg.Categories
GROUP BY CategoryID
HAVING COUNT(*) > 1; --no duplicates found

-- no data types converted. no need for data type conversion fails


--======== stg.Promotions =========

-- checking if nulls exist

SELECT *
FROM stg.Promotions
WHERE PromotionCode IS NULL
   OR PromotionName IS NULL
   OR DiscountPercent IS NULL; -- no nulls found

-- checking for bussiness keys duplicates

SELECT PromotionID, COUNT(*) AS DuplicateCount
FROM stg.Promotions
GROUP BY PromotionID
HAVING COUNT(*) > 1; -- no duplicates found

-- checking for failed data type conversion

SELECT *
FROM ods.Promotions
WHERE DiscountPercent IS NOT NULL
    AND TRIM(DiscountPercent) <> ''
    AND TRY_CONVERT(DECIMAL(5,2),DiscountPercent) IS NULL; -- no failed conversions found

-- looking for incosistent strings
SELECT DISTINCT PromotionCode, PromotionName
FROM stg.Promotions -- none found

-- checking for inconsistent cpitalization which could mean duplicates

SELECT *
FROM stg.Promotions
WHERE PromotionCode <> UPPER(PromotionCode)
   OR PromotionName <> UPPER(PromotionName); --- none found


-- domain validation: checking whether values fall within acceptable business ranges 
-- discount cant be over 100

   SELECT *
FROM stg.Promotions
WHERE DiscountPercent < 0
   OR DiscountPercent > 100; -- no issues found



