SELECT
    ReceiptNumber,
    LineNumber,
    SaleID,
    BookID,
    SaleDate,
    PaymentMethod,
    Quantity,
    UnitPrice,
    DiscountAmount,
    PromotionIDs,
    COUNT(*) AS Repetitions
FROM stg.Sales
GROUP BY
    ReceiptNumber,
    LineNumber,
    SaleID,
    BookID,
    SaleDate,
    PaymentMethod,
    Quantity,
    UnitPrice,
    DiscountAmount,
    PromotionIDs
HAVING COUNT(*) > 1; -- group by all columns, except for SalesLineID to confirm full row is duplicate 


 -- choosing the lowest SalesLineID to keep
SELECT
    ReceiptNumber,
    LineNumber,
    MIN(SalesLineID) AS SalesLineID_To_Keep,
    COUNT(*) AS Repetitions
FROM stg.Sales
GROUP BY ReceiptNumber, LineNumber
HAVING COUNT(*) > 1;
