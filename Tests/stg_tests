--======== stg.Sales =========

-- checking for null values

SELECT *
FROM stg.Sales
WHERE ReceiptNumber IS NULL
   OR BookID IS NULL
   OR SaleDate IS NULL
   OR Quantity IS NULL
   OR UnitPrice IS NULL
   OR PaymentMethod IS NULL
   OR DiscountAmount IS NULL; -- 12 rows  found with null values


-- checking for bussiness keys duplicates

SELECT ReceiptNumber, LineNumber, COUNT(*) AS DuplicateCount
FROM stg.Sales
GROUP BY ReceiptNumber, LineNumber
HAVING COUNT(*) > 1; -- 4 duplicated values found

SELECT *
FROM ods.Sales
WHERE
    (SaleDate IS NOT NULL
    AND TRIM(SaleDate) <> ''
    AND TRY_CONVERT(DATE,TRIM(SaleDate)) IS NULL)
